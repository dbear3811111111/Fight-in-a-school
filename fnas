local ESPBrightness = 1
local ESPColorR = 170
local ESPColorG = 90
local ESPColorB = 255
local ESPHighlights = {}

local function GetESPColor()
	local r = math.clamp(ESPColorR / 255 * ESPBrightness, 0, 1)
	local g = math.clamp(ESPColorG / 255 * ESPBrightness, 0, 1)
	local b = math.clamp(ESPColorB / 255 * ESPBrightness, 0, 1)
	return Color3.new(r, g, b)
end

local function RemoveESP(OtherPlayer)
	local h = ESPHighlights[OtherPlayer]
	if h then
		pcall(function()
			h:Destroy()
		end)
		ESPHighlights[OtherPlayer] = nil
	end
end

local function UpdateHighlightVisual(h)
	if not h then
		return
	end
	local color = GetESPColor()
	h.OutlineColor = color
	h.FillColor = color
	local t = math.clamp(OutlineThickness, 1, 10)
	h.OutlineTransparency = math.clamp(1 - (t / 10), 0, 0.85)
	h.FillTransparency = math.clamp(1.05 - (ESPBrightness * 0.25), 0.7, 1)
end

local function ApplyESP(OtherPlayer)
	if OtherPlayer == Player then
		return
	end

	RemoveESP(OtherPlayer)

	if not ESPEnabled then
		return
	end

	local Character = OtherPlayer.Character
	if not Character then
		return
	end

	local Humanoid = Character:FindFirstChildOfClass("Humanoid")
	if not Humanoid or Humanoid.Health <= 0 then
		return
	end

	local ok, highlight = pcall(function()
		local h = Instance.new("Highlight")
		h.Name = "FIAS_ESP"
		h.Adornee = Character
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		UpdateHighlightVisual(h)
		h.Parent = Character
		return h
	end)

	if ok and highlight then
		ESPHighlights[OtherPlayer] = highlight
	end
end

local function RefreshAllESP()
	for _, OtherPlayer in ipairs(Players:GetPlayers()) do
		if OtherPlayer ~= Player then
			if ESPEnabled then
				ApplyESP(OtherPlayer)
			else
				RemoveESP(OtherPlayer)
			end
		end
	end
end

local function UpdateAllESPVisuals()
	for OtherPlayer, h in pairs(ESPHighlights) do
		if h and h.Parent then
			UpdateHighlightVisual(h)
		elseif ESPEnabled then
			ApplyESP(OtherPlayer)
		end
	end
end

local function ClearAllESP()
	for OtherPlayer, _ in pairs(ESPHighlights) do
		RemoveESP(OtherPlayer)
	end
	table.clear(ESPHighlights)
end

local ESPPlayerConnections = {}

local function HookPlayer(OtherPlayer)
	if OtherPlayer == Player then
		return
	end

	if ESPPlayerConnections[OtherPlayer] then
		return
	end

	local conns = {}

	table.insert(conns, OtherPlayer.CharacterAdded:Connect(function()
		task.wait(0.35)
		if ESPEnabled then
			ApplyESP(OtherPlayer)
		end
	end))

	table.insert(conns, OtherPlayer.CharacterRemoving:Connect(function()
		RemoveESP(OtherPlayer)
	end))

	ESPPlayerConnections[OtherPlayer] = conns

	if OtherPlayer.Character and ESPEnabled then
		ApplyESP(OtherPlayer)
	end
end

local function UnhookPlayer(OtherPlayer)
	local conns = ESPPlayerConnections[OtherPlayer]
	if conns then
		for _, c in ipairs(conns) do
			pcall(function()
				c:Disconnect()
			end)
		end
		ESPPlayerConnections[OtherPlayer] = nil
	end
	RemoveESP(OtherPlayer)
end

for _, OtherPlayer in ipairs(Players:GetPlayers()) do
	HookPlayer(OtherPlayer)
end

Players.PlayerAdded:Connect(function(OtherPlayer)
	HookPlayer(OtherPlayer)
end)

Players.PlayerRemoving:Connect(function(OtherPlayer)
