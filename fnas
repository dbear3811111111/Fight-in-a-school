				data.conn:Disconnect()
			end)
		end
		if data.gui then
			pcall(function()
				data.gui:Destroy()
			end)
		end
		HealthBars[OtherPlayer] = nil
	end
end

local function ClearAllHealthBars()
	for OtherPlayer, _ in pairs(HealthBars) do
		RemoveHealthBar(OtherPlayer)
	end
	table.clear(HealthBars)
end

local function CreateHealthBar(OtherPlayer)
	if OtherPlayer == Player then
		return
	end

	RemoveHealthBar(OtherPlayer)

	if not HealthBarEnabled then
		return
	end

	local Character = OtherPlayer.Character
	if not Character then
		return
	end

	local Humanoid = Character:FindFirstChildOfClass("Humanoid")
	local Head = Character:FindFirstChild("Head")
	if not Humanoid or not Head or Humanoid.Health <= 0 then
		return
	end

	local bb = Instance.new("BillboardGui")
	bb.Name = "FIAS_HealthBar"
	bb.Adornee = Head
	bb.Size = UDim2.new(0, 56, 0, 14)
	bb.StudsOffset = Vector3.new(0, 2.6, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 250
	bb.Parent = Character

	local bg = Instance.new("Frame")
	bg.Name = "BG"
	bg.Size = UDim2.new(1, 0, 1, 0)
	bg.BackgroundColor3 = Color3.fromRGB(20, 10, 30)
	bg.BackgroundTransparency = 0.25
	bg.BorderSizePixel = 0
	bg.Parent = bb

	Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 4)

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(170, 90, 255)
	stroke.Thickness = 1
	stroke.Transparency = 0.35
	stroke.Parent = bg

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.new(1, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(80, 220, 120)
	fill.BorderSizePixel = 0
	fill.Parent = bg

	Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 4)

	local label = Instance.new("TextLabel")
	label.Name = "HP"
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.5
	label.Font = Enum.Font.GothamBold
	label.TextSize = 10
	label.ZIndex = 2
	label.Parent = bg

	local function UpdateBar()
		if not Humanoid or not Humanoid.Parent then
			return
		end
		local maxHp = math.max(Humanoid.MaxHealth, 1)
		local hp = math.clamp(Humanoid.Health, 0, maxHp)
		local alpha = hp / maxHp
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		label.Text = tostring(math.floor(hp + 0.5))

		if alpha > 0.5 then
			fill.BackgroundColor3 = Color3.fromRGB(80, 220, 120)
		elseif alpha > 0.25 then
			fill.BackgroundColor3 = Color3.fromRGB(230, 200, 60)
		else
			fill.BackgroundColor3 = Color3.fromRGB(230, 70, 70)
		end
	end

	UpdateBar()

	local conn = Humanoid.HealthChanged:Connect(UpdateBar)

	HealthBars[OtherPlayer] = {
		gui = bb,
		fill = fill,
		label = label,
		conn = conn
	}
end

