				Enabled = not Enabled
				Update()
				if Callback then
					Callback(Enabled)
				end
			end)

			Update()

			local Control = {}

			function Control:SetState(Value)
				Enabled = Value == true
				Update()
				if Callback then
					Callback(Enabled)
				end
			end

			function Control:GetState()
				return Enabled
			end

