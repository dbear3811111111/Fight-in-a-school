				if Enabled then
					Switch.BackgroundColor3 = Color3.fromRGB(160, 80, 255)
					Knob.Position = UDim2.new(1, -16, 0.5, -7)
					Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				else
					Switch.BackgroundColor3 = Color3.fromRGB(55, 25, 85)
					Knob.Position = UDim2.new(0, 2, 0.5, -7)
					Knob.BackgroundColor3 = Color3.fromRGB(200, 180, 255)
				end
			end

