--==================================================
-- SETTINGS SAVE / LOAD
--==================================================

-- AutoSaveEnabled / LoadingConfig declared earlier
SaveQueued = false
AutoSaveEnabled = false
LoadingConfig = false

local CONFIG_FOLDER = "FightInASchool"
local CONFIG_PATH = CONFIG_FOLDER .. "/settings.json"

local HasFS =
	type(writefile) == "function"
	and type(readfile) == "function"
	and type(isfile) == "function"

local function EnsureFolder()
	if type(makefolder) ~= "function" or type(isfolder) ~= "function" then
		return HasFS
	end
	pcall(function()
		if not isfolder(CONFIG_FOLDER) then
			makefolder(CONFIG_FOLDER)
		end
	end)
	return true
end

local function CollectSettings()
	local key = GuiKeybind:GetKey()
	return {
		autoSave = AutoSaveEnabled,
		walkspeedEnabled = WalkSpeedEnabled,
		walkspeed = CurrentWalkSpeed,
		lockOnEnabled = LockOnEnabled,
		lockOnRadius = LockOnRadius,
		lockOnSmooth = LockOnSmooth,
		wallCheckEnabled = WallCheckEnabled,
		espEnabled = ESPEnabled,
		outlineThickness = OutlineThickness,
		espBrightness = ESPBrightness,
		espColorR = ESPColorR,
		espColorG = ESPColorG,
		espColorB = ESPColorB,
		healthBarEnabled = HealthBarEnabled,
		guiToggleKey = key and key.Name or nil
	}
end

local function SaveSettings()
	if not HasFS then
		return false, "Filesystem not supported"
	end

	EnsureFolder()

	local data = CollectSettings()
	local okEncode, encoded = pcall(function()
		return game:GetService("HttpService"):JSONEncode(data)
	end)

	if not okEncode then
		return false, "Encode failed"
	end

	local okWrite = pcall(function()
		writefile(CONFIG_PATH, encoded)
	end)

	return okWrite, okWrite and "Saved" or "Write failed"
end

function QueueSave()
	if LoadingConfig or not AutoSaveEnabled then
		return
	end
	if SaveQueued then
		return
	end
	SaveQueued = true
	task.defer(function()
		task.wait(0.15)
		SaveQueued = false
		if AutoSaveEnabled and not LoadingConfig then
			SaveSettings()
		end
	end)
end

local function ApplySettings(data)
	if type(data) ~= "table" then
		return
	end

	LoadingConfig = true

	if type(data.walkspeed) == "number" and WalkspeedSlider then
		WalkspeedSlider:SetValue(data.walkspeed)
	end

	if data.walkspeedEnabled == true and WalkspeedToggle then
		WalkspeedToggle:SetState(true)
	elseif data.walkspeedEnabled == false and WalkspeedToggle then
		WalkspeedToggle:SetState(false)
	end

	if type(data.outlineThickness) == "number" and ESPThicknessSlider then
		ESPThicknessSlider:SetValue(data.outlineThickness)
	end

	if type(data.espBrightness) == "number" and ESPBrightnessSlider then
		ESPBrightnessSlider:SetValue(data.espBrightness)
	end

	if type(data.espColorR) == "number" and ESPColorRSlider then
		ESPColorRSlider:SetValue(data.espColorR)
	end

	if type(data.espColorG) == "number" and ESPColorGSlider then
		ESPColorGSlider:SetValue(data.espColorG)
	end

	if type(data.espColorB) == "number" and ESPColorBSlider then
		ESPColorBSlider:SetValue(data.espColorB)
	end

	if type(data.lockOnRadius) == "number" and LockOnRadiusSlider then
		LockOnRadiusSlider:SetValue(data.lockOnRadius)
	end
	if type(data.lockOnSmooth) == "number" and LockOnSmoothSlider then
		LockOnSmoothSlider:SetValue(data.lockOnSmooth)
	end
	if data.wallCheckEnabled == true and WallCheckToggle then
		WallCheckToggle:SetState(true)
	elseif data.wallCheckEnabled == false and WallCheckToggle then
		WallCheckToggle:SetState(false)
	end
	if data.lockOnEnabled == true and LockOnToggle then
		LockOnToggle:SetState(true)
	elseif data.lockOnEnabled == false and LockOnToggle then
		LockOnToggle:SetState(false)
	end

	if data.espEnabled == true and ESPToggle then
		ESPToggle:SetState(true)
	elseif data.espEnabled == false and ESPToggle then
		ESPToggle:SetState(false)
	end

	if data.healthBarEnabled == true and HealthBarToggle then
		HealthBarToggle:SetState(true)
	elseif data.healthBarEnabled == false and HealthBarToggle then
		HealthBarToggle:SetState(false)
	end

	if type(data.guiToggleKey) == "string" then
		local key = Enum.KeyCode[data.guiToggleKey]
		if key then
			GuiKeybind:SetKey(key)
		end
	end

	if data.autoSave == true then
		AutoSaveEnabled = true
	end

	LoadingConfig = false
end

local function LoadSettings()
	if not HasFS then
		return false, "Filesystem not supported"
	end

	local exists = false
	pcall(function()
		exists = isfile(CONFIG_PATH)
	end)

	if not exists then
		return false, "No saved settings"
	end

	local okRead, raw = pcall(readfile, CONFIG_PATH)
	if not okRead or type(raw) ~= "string" then
		return false, "Read failed"
	end

	local okDecode, data = pcall(function()
		return game:GetService("HttpService"):JSONDecode(raw)
	end)

	if not okDecode or type(data) ~= "table" then
		return false, "Invalid settings"
	end

	ApplySettings(data)
	return true, "Loaded"
end

