local Auto = Window:CreateTab("Auto")

Auto:CreateSection("Lock On")

local LockOnEnabled = false
local LockOnRadius = 50
local LockOnSmooth = 0.35
local WallCheckEnabled = false
local LockOnTarget = nil
local LockOnConnection = nil

local function HasLineOfSight(fromPos, toPos, targetCharacter)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = {}
	if Player.Character then
		table.insert(exclude, Player.Character)
	end
	if targetCharacter then
		table.insert(exclude, targetCharacter)
	end
	params.FilterDescendantsInstances = exclude
	params.IgnoreWater = true

	local direction = toPos - fromPos
	local result = workspace:Raycast(fromPos, direction, params)
	-- no hit = clear path; hit something that isn't the target = blocked
	return result == nil
end

local function IsValidTarget(OtherPlayer)
	if not OtherPlayer or OtherPlayer == Player then
		return false
	end
	if not OtherPlayer.Parent or not OtherPlayer.Character then
		return false
	end

	local Character = OtherPlayer.Character
	local Humanoid = Character:FindFirstChildOfClass("Humanoid")
	local Head = Character:FindFirstChild("Head")
	local Root = Character:FindFirstChild("HumanoidRootPart")

	if not Humanoid or not Head or not Root then
		return false
	end
	if Humanoid.Health <= 0 then
		return false
	end

	local MyRoot = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
	if not MyRoot then
		return false
	end

	local Distance = (MyRoot.Position - Root.Position).Magnitude
	if Distance > LockOnRadius then
		return false
	end

	if WallCheckEnabled then
		local Camera = workspace.CurrentCamera
		local fromPos = Camera and Camera.CFrame.Position or MyRoot.Position
		if not HasLineOfSight(fromPos, Head.Position, Character) then
			return false
		end
	end

	return true
end

local function GetBestTarget()
	local Character = Player.Character
	local MyRoot = Character and Character:FindFirstChild("HumanoidRootPart")
	if not MyRoot then
		return nil
	end

	local Camera = workspace.CurrentCamera
	if not Camera then
		return nil
	end

	local Origin = Camera.CFrame.Position
	local Look = Camera.CFrame.LookVector

	local Best = nil
	local BestAngle = math.huge -- smallest angle to crosshair wins

	for _, OtherPlayer in ipairs(Players:GetPlayers()) do
		if IsValidTarget(OtherPlayer) then
			local Head = OtherPlayer.Character:FindFirstChild("Head")
			if Head then
				local ToTarget = Head.Position - Origin
				local Dist = ToTarget.Magnitude
				if Dist > 0.5 then
					local Unit = ToTarget.Unit
					local Dot = Unit:Dot(Look)
					-- Must be at least somewhat in front of camera
					if Dot > 0.35 then
						-- angle from look direction (0 = dead center)
						local Angle = math.acos(math.clamp(Dot, -1, 1))
						if Angle < BestAngle then
							BestAngle = Angle
							Best = OtherPlayer
						end
					end
				end
			end
		end
	end

	return Best
end

local function StopLockOn()
	LockOnEnabled = false
	LockOnTarget = nil
	if LockOnConnection then
		LockOnConnection:Disconnect()
		LockOnConnection = nil
	end
end

local function StartLockOn()
	if LockOnConnection then
		LockOnConnection:Disconnect()
		LockOnConnection = nil
	end

	LockOnEnabled = true
	LockOnTarget = GetBestTarget()

	LockOnConnection = RunService.RenderStepped:Connect(function(dt)
		if not LockOnEnabled then
			return
		end

		local Camera = workspace.CurrentCamera
		if not Camera then
			return
		end

		-- Always pick whoever your camera is pointing at (within radius / wall rules)
		LockOnTarget = GetBestTarget()

		if not LockOnTarget or not LockOnTarget.Character then
			return
		end

		local Head = LockOnTarget.Character:FindFirstChild("Head")
		if not Head then
			return
		end

		local AimPos = Head.Position + Vector3.new(0, 0.15, 0)
		local Origin = Camera.CFrame.Position
		local Desired = CFrame.lookAt(Origin, AimPos)

		local smooth = math.clamp(LockOnSmooth, 0, 1)
		local alpha
		if smooth <= 0.02 then
			alpha = 1
		else
			-- 0 = instant lock, 1 = very smooth/slow
			alpha = math.clamp(dt * (1.2 + (1 - smooth) * 28), 0, 1)
		end

		Camera.CFrame = Camera.CFrame:Lerp(Desired, alpha)
	end)
end

